# Локально: export BOT_TOKEN=...  або TELEGRAM_BOT_TOKEN
# VPS (Docker): скопіюйте у .env і заповніть значення; файл .env не комітити.
BOT_TOKEN=123456789:AA...your_token_from_BotFather
# TELEGRAM_BOT_TOKEN=   # альтернативне ім’я змінної

# --- Docker Compose + PostgreSQL (docker-compose.yml на VPS) ---
# Пароль користувача telc у контейнері postgres; той самий використовується в DATABASE_URL для бота.
POSTGRES_PASSWORD=change_me_strong_unique

# Якщо задано DATABASE_URL — використовується Postgres за цим рядком (локально, Railway, зовнішня БД на VPS).
# У штатному docker-compose.yml з вбудованим postgres НЕ додавайте DATABASE_URL у .env — його задає compose.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Лише якщо НЕМАЄ DATABASE_URL — SQLite (шлях за замовчуванням: telc_bot.sqlite у каталозі проєкту)
# SQLITE_PATH=/data/telc_bot.sqlite

# ROLLING_SCAN_DAYS=7
# PHASE1_MAX_SPAN_DAYS=400
# USERS_JSON_LEGACY=users_data.json
